{
  "name": "@selemondev/svelte-marquee",
  "version": "0.1.5",
  "description": "A Beautiful Marquee component for Svelte ✨",
  "type": "module",
  "license": "MIT",
  "author": "Selemondev",
  "homepage": "https://github.com/selemondev/svelte-marquee#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selemondev/svelte-marquee.git"
  },
  "bugs": {
    "url": "https://github.com/selemondev/svelte-marquee/issues"
  },
  "keywords": [
    "svelte",
    "marquee",
    "tailwindcss",
    "typescript",
    "svelte-marquee"
  ],
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^22 || ^24",
    "pnpm": ">=10"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && pnpm package",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "package": "svelte-kit sync && svelte-package && pnpm build:css:app && pnpm build:css:lib && rimraf dist/css && publint",
    "build:css:lib": "tailwindcss --input ./src/lib/css/tailwind.css --output ./dist/style.css --optimize",
    "build:css:app": "tailwindcss --input ./src/assets/css/tailwind.css --output ./dist/index.css --optimize",
    "prepublishOnly": "pnpm package",
    "generate:release:minor": "pnpm dlx changelogen@latest --release --minor",
    "generate:release:major": "pnpm dlx changelogen@latest --release --major",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@sveltejs/adapter-vercel": "^5.10.3",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "hastscript": "^9.0.1",
    "publint": "^0.3.24",
    "rimraf": "^6.1.3",
    "shiki": "^3.23.0",
    "shiki-block-svelte": "^1.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tslib": "^2.8.1",
    "typescript": "^7.0.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.4.3"
  }
}
